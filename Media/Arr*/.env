# ============================================================================
#  Stack configuration. Edit these, then: docker compose up -d
# ============================================================================

# --- User / permissions -----------------------------------------------------
# macOS + Docker Desktop: leave these at 1000. Docker Desktop maps ownership
#   for you, so the values are effectively cosmetic.
# Linux (the i7 box): run `id -u` and `id -g` and put the real numbers here.
PUID=1000
PGID=1000

# 002 = owner + group can write. TRaSH-recommended when all apps share a group.
UMASK=002

# --- Locale -----------------------------------------------------------------
TZ=America/Toronto

# --- Jellyfin ---------------------------------------------------------------
# The URL clients should use. On the Linux box change to http://<server-ip>:8096
JELLYFIN_URL=http://localhost:8096

# --- SABnzbd ----------------------------------------------------------------
# Add your server's LAN IP so you can reach SAB from another machine.
# Leave blank while testing on this Mac.
HOST_LAN_IP=100.64.0.5

# --- Recyclarr --------------------------------------------------------------
# Fill these in at Step 12 of SETUP.md (Radarr/Sonarr -> Settings -> General).
# Recyclarr will not work until they are set.
RADARR_API_KEY=787f0024fdbf439eb11b1491cd57f089
SONARR_API_KEY=8b8732477b5f4588bde2ac6f1cee9c72

# Cron for the nightly TRaSH sync (default: 4am daily)
RECYCLARR_CRON=0 4 * * *

# --- qBittorrent WebUI (set during automated setup) ---------------------------
QBIT_USERNAME=admin
QBIT_PASSWORD=5JUvXKal276osJrYAjxwAWSt
